{
  "name": "expiry-keeper",
  "private": true,
  "version": "2.1.1",
  "type": "module",
  "description": "为养猫家庭设计的商品效期与库存管理 App",
  "scripts": {
    "dev": "node --require ./scripts/patch-net-use.cjs ./node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5273",
    "dev:https": "node --require ./scripts/patch-net-use.cjs ./node_modules/vite/bin/vite.js --host 0.0.0.0 --port 5274 --mode https",
    "build": "tsc --noEmit && node --require ./scripts/patch-net-use.cjs ./node_modules/vite/bin/vite.js build",
    "preview": "node --require ./scripts/patch-net-use.cjs ./node_modules/vite/bin/vite.js preview --host 0.0.0.0 --port 5275",
    "shot": "node scripts/shot.mjs",
    "release": "node scripts/release.mjs",
    "release:serve": "node scripts/serve-release.mjs",
    "server": "node server/index.mjs",
    "test:server": "node --test server/test/*.test.mjs",
    "android:sync": "node --require ./scripts/patch-net-use.cjs ./node_modules/vite/bin/vite.js build && npx cap sync android",
    "android:apk": "node scripts/build-apk.mjs",
    "android:apk:open": "node scripts/build-apk.mjs --open-source"
  },
  "dependencies": {
    "@capacitor/android": "^6.2.2",
    "@capacitor/app": "^6.0.3",
    "@capacitor/camera": "^6.1.3",
    "@capacitor/cli": "^6.2.2",
    "@capacitor/core": "^6.2.2",
    "@capacitor/device": "^6.0.3",
    "@capacitor/local-notifications": "^6.1.3",
    "@capacitor/splash-screen": "^6.0.4",
    "@capacitor/status-bar": "^6.0.3",
    "@zxing/browser": "^0.2.1",
    "@zxing/library": "^0.23.0",
    "better-sqlite3": "^13.0.3",
    "express": "^5.3.0",
    "express-rate-limit": "^8.7.1",
    "lucide-react": "^1.48.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0"
  },
  "devDependencies": {
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-basic-ssl": "^2.3.0",
    "@vitejs/plugin-react": "^6.1.1",
    "playwright": "^1.63.0",
    "supertest": "^7.3.1",
    "typescript": "^5.9.0",
    "vite": "^8.3.1"
  }
}
